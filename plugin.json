{
    "id": "bluetoothUsage",
    "name": "Bluetooth Usage",
    "description": "Track connected, listening and idle time for Bluetooth audio devices, with per-device history, battery and weekly summaries",
    "version": "1.1.2",
    "license": "MIT",
    "author": "rythamo",
    "icon": "bluetooth",
    "type": "composite",
    "capabilities": ["daemon", "dankbar-widget", "ipc"],
    "dependencies": ["pactl"],
    "components": {
        "daemon": "./BluetoothUsageDaemon.qml",
        "widget": "./BluetoothUsageWidget.qml"
    },
    "settings": "./BluetoothUsageSettings.qml",
    "requires_dms": ">=2.1.0",
    "permissions": ["settings_read", "settings_write", "process"]
}
